 # ------------------------------------------------------------------ style picks
 
+# Palettes whose ink AND accent are black or grey, so the whole sheet prints
+# on the black cartridge alone. Every other palette is a dark colour: the same
+# coverage, but CMY rather than K, which costs more per page.
+BLACK_ONLY = ("bw", "bwgrey")
+BLACK_SHARE = 0.6
+
+
+def black_first(pals):
+    """Order the palettes so any prefix of them is ~60% black.
+
+    A phrase gets its variants by walking down this list, and most phrases
+    take only two or three, so the ORDER is what decides the ink bill - not
+    how many colours exist. Interleaving to hold the share at every position
+    means the catalogue is 60% black whether a phrase has two versions or
+    twenty, instead of depending on where it happened to stop.
+
+    Colour is not dropped altogether because the palette name goes in the
+    title and decor buyers search it - "sage green kitchen print" is a real
+    search that a black and white listing does not answer.
+    """
+    black = [p for p in BLACK_ONLY if p in pals] or list(BLACK_ONLY)
+    colour = [p for p in pals if p not in BLACK_ONLY]
+    out, nb, bi, ci = [], 0, 0, 0
+    while ci < len(colour) or bi < len(black):
+        n = len(out) + 1
+        # take whichever choice leaves the running share closest to target
+        take_black = abs((nb + 1) / n - BLACK_SHARE) <= abs(nb / n - BLACK_SHARE)
+        if (take_black and bi < len(black) * 99) or ci >= len(colour):
+            out.append(black[bi % len(black)]); bi += 1; nb += 1
+        else:
+            out.append(colour[ci]); ci += 1
+    return out
+
+
