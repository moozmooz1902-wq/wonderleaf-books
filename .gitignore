
# EBAY_ONE_FILE.zip holds the same bytes; rebuild the CSV with tshirt/combine.py.
# The joined upload CSV is 206 MB, over GitHub's 100 MB file limit.
*.pyc
__pycache__/
tshirt/EBAY_ONE_FILE.csv
tshirt/EBAY_PART1of3.csv
tshirt/EBAY_PART2of3.csv
tshirt/EBAY_PART3of3.csv
__pycache__/
*.pyc

# The gradient hashes dup_audit.py --fetch pulls down: 275 MB and growing,
# one .jsonl per bucket-range. Re-derivable in one command from the panels
# in R2, which are the real record, so committing it buys nothing and would
# push individual files toward GitHub's limit.
wallart-data/hashes/

# OnBuy build output. The three upload CSVs are 34 MB loose and the
# canonical rows.jsonl is 79 MB; both rebuild in 23 seconds from
# build_onbuy.py, onbuy_plan.json, gen/subjects.json and the hash files.
# What IS committed is wallart-data/out/onbuy/luxvia-art_onbuy_10k.zip -
# the same three CSVs at 1.6 MB, because the descriptions compress - and
# the small test files, which are what actually gets uploaded first.
wallart-data/out/onbuy/*.csv
wallart-data/out/onbuy/*_rows.jsonl
wallart-data/out/onbuy/tests/*_rows.jsonl

# The rebuilt job grid: 136 MB, and grid.expand() over gen/subjects.json
# reproduces it exactly in 22 seconds. build_onbuy.py says so if it is
# missing.
wallart-data/pool_jobs.json
wallart-data/out/onbuy/feed*/

# Local-only secrets for `astro dev` / `wrangler dev`. Never committed.
.dev.vars
