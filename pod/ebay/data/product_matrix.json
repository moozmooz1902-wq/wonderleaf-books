  "store_rotation": {
    "note": "One design library, several storefronts. The library is the asset; the stores are distribution and account-risk hedging. Observed: t-shirt-junky and love_tshirts share 12% of stems on a 5% sample.",
    "rules": [
      "Never list the identical design+product pair twice within ONE store - that is the duplicate-listing violation.",
      "The same design+product MAY appear in different stores, but vary the title's keyword padding per store so the listings are not byte-identical.",
      "Give each store a slight theme bias so they do not compete head-on in the same search."
    ]
  },

  "policy_guardrails": [
    "Size and colour are VARIATIONS within a single multi-variation listing. Splitting them into separate listings is the classic eBay duplicate-listing breach.",
    "Different garment type = genuinely different item = separate listing is fine.",
    "Different print format (poster vs canvas vs float) = genuinely different item = separate listing is fine.",
    "Keep titles under 80 characters. Over-length titles are truncated and the tail never indexes.",
    "Do not keyword-stuff brand names into titles or item specifics - eBay's VeRO programme is the fastest route to account restriction."
  ]
