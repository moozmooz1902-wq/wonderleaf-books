{
  "name": "wallart-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node -e \"require('fs').writeFileSync('dist/.assetsignore','_worker.js\\n_routes.json\\n')\"",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:seed:local": "wrangler d1 execute wallart --local --file=../catalogue/seed.sql",
    "db:seed:remote": "wrangler d1 execute wallart --remote --file=../catalogue/seed.sql"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/cloudflare": "^12.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
