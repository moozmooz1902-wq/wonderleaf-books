---
import Base from '../layouts/Base.astro';
import Grid from '../components/Grid.astro';
import { B, TAX, money, img } from '../lib/shop';
import { getDb, nicheCounts, bySection, byNiche, byNicheColour, bySectionColour } from '../lib/db';
import { edge, TTL_CATALOGUE } from '../lib/cache';

const db = getDb(Astro.locals);
const { results: counts } = await nicheCounts(db);
// THE LEAD BLOCK IS ANIMALS IN COLOUR, NOT CHARCOAL.
//
// Charcoal leads the measured data - 5.96% against a 1.05% base rate on the
// seller's own eBay watchers, z=+5.9, the strongest single signal in the
// project - and it led this block for that reason. It is still the largest
// technique in the range and it still has its own page at
// /style/charcoal-drawings.
//
// It is not what the home page opens with any more. A grid of twelve
// black-and-white drawings on a cream page reads as dull at a glance, and a
// home page is judged at a glance; the demand signal says what people buy
// once they are looking at prints, not what makes them look. So the lead is
// the colourful end of the animals section, which is the most immediately
// legible thing in the catalogue.
const { results: lead } = await bySectionColour(
  db, 'animals', ['colourful', 'bold-colour', 'two-tone'], 12);
const { results: coast } = await bySection(db, 'landscapes', 8);
// THE LARGE IMAGES, DRAWN FROM THE CATALOGUE.
//
// Each one is a real product the visitor can buy, not marketing imagery -
// so there is no second set of photographs to keep in step with the range,
// and nothing on the home page can advertise something that is not for
// sale. Picked from three different sections so the page does not read as
// three versions of one picture, and from the colourful end of the range
// because these are shown very large and the charcoals disappear at that
// size against a white page.
const big = async (niche: string) => {
  const { results } = await byNicheColour(db, niche, ['colourful', 'bold-colour'], 1);
  if (results?.length) return results[0];
  const { results: any } = await byNiche(db, niche, 1);
  return any[0];
};
const heroArt = await big('british-coast');
const featA = await big('the-moon');
const featB = await big('british-wildlife');

const bySec = TAX.sections.map((s) => ({
  ...s,
  niches: counts.filter((c) => c.section === s.slug),
  total: counts.filter((c) => c.section === s.slug).reduce((a, c) => a + c.n, 0),
}));
const total = counts.reduce((a, c) => a + c.n, 0);
// Read off the catalogue rather than written into the copy. A price typed
// into a sentence is a price that goes stale silently, and a page that
// quotes a different number from the feed is the mismatch this whole build
// exists to avoid.
const minUnframed = TAX.prices?.unframed_from ?? 8.99;
const minFramed = TAX.prices?.framed_from ?? 24.99;
edge(Astro.response, TTL_CATALOGUE);
---

<Base
  title={`${B.brand} - Framed Wall Art Prints, Made in the UK`}
  description={`Framed art prints in ${total} designs across ${counts.length} ranges - British coast, wildlife, botanical, night sky. Printed and framed to order in the United Kingdom.`}
>
  {/* THE HERO. A flat field of type beside a full-bleed panel with one
      print hung large in it. The print is a real product; clicking either
      half goes to it. */}
  <section class="hero-split">
    <div class="hero-split-copy">
      <p class="eyebrow">Printed &amp; framed in Britain</p>
      <h1>Quiet art for considered walls</h1>
      <p class="lede">
        {total} designs across {counts.length} collections — the British
        coast, wildlife and birds, botanical studies and the night sky. Each
        one printed on {B.fulfilment.paper} and framed by hand after you
        order it.
      </p>
      <a class="link-lux" href="/c/landscapes">Discover the collections</a>
      <div class="hero-split-meta">
        <span>Free UK delivery</span>
        <span>{B.returns.window_days}-day returns</span>
        <span>A4 · A3 · A2</span>
      </div>
    </div>
    <a class="hero-split-art" href={`/art/${heroArt.slug}`} aria-label={heroArt.title}>
      <img src={img(heroArt.image_path)} alt={heroArt.title} width="1000"
           height="1000" fetchpriority="high" decoding="async" />
    </a>
  </section>

  <section class="feature">
    <div class="feature-copy">
      <p class="eyebrow">The night sky</p>
      <h2>{featA.subject}</h2>
      <p>
        Moons, constellations and the small hours, drawn rather than
        photographed. The quietest range we make and the one people hang in
        bedrooms.
      </p>
      <a class="btn-lux" href="/c/night-sky">Shop the night sky</a>
    </div>
    <a class="feature-art" href={`/art/${featA.slug}`} aria-label={featA.title}>
      <img src={img(featA.image_path)} alt={featA.title} width="900"
           height="900" loading="lazy" decoding="async" />
    </a>
  </section>

  <section class="feature flip">
    <div class="feature-copy">
      <p class="eyebrow">Animals &amp; wildlife</p>
      <h2>{featB.subject}</h2>
      <p>
        British birds, mammals and breed studies. Generic breed names only —
        no named animals and no mascots.
      </p>
      <a class="btn-lux" href="/c/animals">Shop animals &amp; wildlife</a>
    </div>
    <a class="feature-art" href={`/art/${featB.slug}`} aria-label={featB.title}>
      <img src={img(featB.image_path)} alt={featB.title} width="900"
           height="900" loading="lazy" decoding="async" />
    </a>
  </section>

  {/* The reassurance strip. Every line is a fact stated elsewhere on the
      site and in the feed - made in Britain, the real dispatch time, the
      returns window, VAT included. Nothing aspirational, nothing that
      needs a reviewer to take our word for it. */}
  <section class="assurance">
    <div class="wrap assurance-grid">
      <div><strong>Made to order</strong><span>Printed &amp; framed in {B.fulfilment.made_in}</span></div>
      <div><strong>Free UK delivery</strong><span>Dispatched in {B.fulfilment.dispatch_working_days} working days</span></div>
      <div><strong>{B.returns.window_days}-day returns</strong><span>From the day it arrives, any reason</span></div>
      <div><strong>Prices include VAT</strong><span>No surprises at checkout</span></div>
    </div>
  </section>

  <section class="wrap">
    <div class="section-block">
      <p class="kicker">Animals &amp; wildlife</p>
      <h2>Birds, beasts and breed studies</h2>
      <p class="prose" style="max-width:62ch">
        British birds and mammals, and breed studies for the dogs people
        actually keep. Generic breed names only — no named animals, no
        mascots.
      </p>
      <Grid items={lead} />
      <a class="opt" href="/c/animals">See all animals &amp; wildlife</a>
    </div>

    <div class="section-block">
      <p class="kicker">Browse</p>
      <h2>Find your range</h2>
      <div class="sections">
        {bySec.map((s) => (
          <div style="padding:16px 0">
            <h3>
              <a href={`/c/${s.slug}`} style="text-decoration:none">{s.title}</a>
              <i style="font-style:normal;color:var(--ink-3);font-size:0.8rem;font-weight:400"> &nbsp;{s.total} designs</i>
            </h3>
            <div class="chips">
              {s.niches.map((n) => (
                <a class="chip" href={`/c/${s.slug}/${n.niche}`}>
                  <b>{n.niche_title}</b><i>{n.n}</i>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="section-block">
      <p class="kicker">Landscapes</p>
      <h2>Named places, drawn by hand</h2>
      <Grid items={coast} />
      <a class="opt" href="/c/landscapes">See all landscapes</a>
    </div>

    <div class="section-block">
      <h2>How it works</h2>
      <ul class="facts" style="max-width:70ch">
        <li>
          Choose a design, a size, and a frame or no frame at all. Unframed
          prints from {money(minUnframed)}; framed from {money(minFramed)}.
          All prices include VAT.
        </li>
        <li>We print it on {B.fulfilment.paper} and frame it behind glazing, with the hanging fixture fitted.</li>
        <li>Dispatched within {B.fulfilment.dispatch_working_days} working days, then {B.fulfilment.delivery[0].min_days}–{B.fulfilment.delivery[0].max_days} working days in the post.</li>
        <li>{B.returns.window_days} days to send it back from the day it arrives, for any reason.</li>
        <li>Every design is digitally created artwork, printed to order. Not a painting, not an original, not signed.</li>
      </ul>
    </div>
  </section>
</Base>
