---
import Base from '../layouts/Base.astro';
import Grid from '../components/Grid.astro';
import { B, TAX, money, img } from '../lib/shop';
import { getDb, nicheCounts, byStyle, bySection, byNiche } from '../lib/db';
import { edge, TTL_CATALOGUE } from '../lib/cache';

const db = getDb(Astro.locals);
const { results: counts } = await nicheCounts(db);
// Charcoal leads the home page because it leads the measured data: on the
// seller's own eBay watchers it ran at 5.96% against a 1.05% base rate,
// z=+5.9, the strongest single signal in the project.
const { results: lead } = await byStyle(db, 'charcoal-drawings', 12);
const { results: coast } = await bySection(db, 'landscapes', 8);
// The banner's three plates. Drawn from the catalogue so the first thing a
// visitor sees is buyable, and pulled from three different niches so the
// trio does not read as three versions of one picture.
const { results: heroA } = await byNiche(db, 'british-coast', 1);
const { results: heroB } = await byNiche(db, 'the-moon', 1);
const { results: heroC } = await byNiche(db, 'british-birds', 1);
const hero = [...heroA, ...heroB, ...heroC];

const bySec = TAX.sections.map((s) => ({
  ...s,
  niches: counts.filter((c) => c.section === s.slug),
  total: counts.filter((c) => c.section === s.slug).reduce((a, c) => a + c.n, 0),
}));
const total = counts.reduce((a, c) => a + c.n, 0);
edge(Astro.response, TTL_CATALOGUE);
---

<Base
  title={`${B.brand} - Framed Wall Art Prints, Made in the UK`}
  description={`Framed art prints in ${total} designs across ${counts.length} ranges - British coast, wildlife, botanical, night sky. Printed and framed to order in the United Kingdom.`}
>
  {/* THE BANNER. Two columns on a desktop, stacked on a phone, with the
      hero image taken straight from the catalogue rather than a stock
      photograph - so what a visitor sees first is a thing they can
      actually buy, and there is no second set of marketing imagery to keep
      in step with the products. */}
  <section class="banner">
    <div class="wrap banner-grid">
      <div class="banner-copy">
        <p class="kicker">Printed &amp; framed in Britain</p>
        <h1>Quiet art<br />for considered walls</h1>
        <p class="lede">
          {total} designs across {counts.length} collections — the
          British coast, wildlife and birds, botanical studies and the night
          sky. Each one printed on heavyweight art paper and framed by hand
          after you order it.
        </p>
        <div class="banner-cta">
          <a class="btn-lux" href="/style/charcoal-drawings">Explore the charcoal collection</a>
          <a class="btn-lux ghost" href="/c/landscapes">Browse landscapes</a>
        </div>
        <div class="banner-meta">
          <span>Free UK delivery</span>
          <span>{B.returns.window_days}-day returns</span>
          <span>A4 · A3 · A2</span>
        </div>
      </div>

      <div class="banner-art" aria-hidden="true">
        {hero.slice(0, 3).map((p, i) => (
          <figure class={`banner-plate plate-${i + 1}`}>
            <img
              src={img(p.image_path)}
              alt=""
              width="900"
              height="900"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* The reassurance strip. Every line is a fact stated elsewhere on the
      site and in the feed - made in Britain, the real dispatch time, the
      returns window, VAT included. Nothing aspirational, nothing that
      needs a reviewer to take our word for it. */}
  <section class="assurance">
    <div class="wrap assurance-grid">
      <div><strong>Made to order</strong><span>Printed &amp; framed in {B.fulfilment.made_in}</span></div>
      <div><strong>Free UK delivery</strong><span>Dispatched in {B.fulfilment.dispatch_working_days} working days</span></div>
      <div><strong>{B.returns.window_days}-day returns</strong><span>From the day it arrives, any reason</span></div>
      <div><strong>Prices include VAT</strong><span>No surprises at checkout</span></div>
    </div>
  </section>

  <section class="wrap">
    <div class="section-block">
      <p class="kicker">The charcoal range</p>
      <h2>Worked in black on paper</h2>
      <p class="prose" style="max-width:62ch">
        Soft charcoal, smudged and reworked, with nothing but tone doing the
        work. It is the quietest thing we make and the easiest to hang.
      </p>
      <Grid items={lead} />
      <a class="opt" href="/style/charcoal-drawings">See all charcoal drawings</a>
    </div>

    <div class="section-block">
      <p class="kicker">Browse</p>
      <h2>Find your range</h2>
      <div class="sections">
        {bySec.map((s) => (
          <div style="padding:16px 0">
            <h3>
              <a href={`/c/${s.slug}`} style="text-decoration:none">{s.title}</a>
              <i style="font-style:normal;color:var(--ink-3);font-size:0.8rem;font-weight:400"> &nbsp;{s.total} designs</i>
            </h3>
            <div class="chips">
              {s.niches.map((n) => (
                <a class="chip" href={`/c/${s.slug}/${n.niche}`}>
                  <b>{n.niche_title}</b><i>{n.n}</i>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="section-block">
      <p class="kicker">Landscapes</p>
      <h2>Named places, drawn by hand</h2>
      <Grid items={coast} />
      <a class="opt" href="/c/landscapes">See all landscapes</a>
    </div>

    <div class="section-block">
      <h2>How it works</h2>
      <ul class="facts" style="max-width:70ch">
        <li>Choose a design, a frame colour and a size. Prices from {money(24.99)} including VAT.</li>
        <li>We print it on heavyweight matte art paper and frame it behind glazing, with the hanging fixture fitted.</li>
        <li>Dispatched within {B.fulfilment.dispatch_working_days} working days, then {B.fulfilment.delivery[0].min_days}–{B.fulfilment.delivery[0].max_days} working days in the post.</li>
        <li>{B.returns.window_days} days to send it back from the day it arrives, for any reason.</li>
        <li>Every design is digitally created artwork, printed to order. Not a painting, not an original, not signed.</li>
      </ul>
    </div>
  </section>
</Base>
