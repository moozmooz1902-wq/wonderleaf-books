---
/**
 * THE SHOP'S BACK OFFICE.
 *
 * Built 31 Oct 2026, because "have we had any visitors or orders" had no
 * answer anywhere. Cloudflare's analytics need a permission our API token
 * does not have, Merchant Center publishes no engagement API, and the site
 * recorded nothing. Everything on this page comes out of our own D1 -
 * no third-party script, no tracking cookie, no data leaving the Worker.
 *
 * It deliberately does NOT use the shop's Base layout. The shop's layout
 * carries the shop's header, footer, legal identity and canonical tag; a
 * private admin page wants none of those, and inheriting them is how an
 * admin screen ends up in a sitemap.
 *
 * NOT INDEXABLE, THREE WAYS, because one is not enough: robots.txt
 * disallows /admin, this page sends X-Robots-Tag: noindex, and it is behind
 * a key so a crawler that ignored both would get a login form.
 */
import { adminKey, authed, cookieHeader } from '../../lib/admin';

const env = (Astro.locals as any)?.runtime?.env;
const url = new URL(Astro.request.url);
const key = adminKey(env);

Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
Astro.response.headers.set('cache-control', 'no-store');

let bad = false;

// A POST is the login form. Keeping it a POST keeps the key out of the
// address bar and out of browser history, which a GET with ?key= would not.
if (Astro.request.method === 'POST' && key) {
  const form = await Astro.request.formData().catch(() => null);
  const given = String(form?.get('key') ?? '');
  if (given && given === key) {
    const secure = url.protocol === 'https:';
    return new Response(null, {
      status: 303,
      headers: { location: '/admin', 'set-cookie': cookieHeader(key, secure) },
    });
  }
  bad = true;
}

const ok = key ? authed(Astro.request, url, env) : false;

// A key handed over in the query string still works - it is how you get in
// from a phone shortcut - but it is immediately exchanged for a cookie and
// the URL is cleaned up.
if (ok && url.searchParams.get('key')) {
  return new Response(null, {
    status: 303,
    headers: {
      location: '/admin',
      'set-cookie': cookieHeader(key as string, url.protocol === 'https:'),
    },
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>Walryvo — back office</title>
    {/* ADD TO HOME SCREEN, and then it can be pushed to. iOS only allows
        web notifications from an installed app, so the manifest is not a
        nicety here - it is the whole mechanism. */}
    <link rel="manifest" href="/admin.webmanifest" />
    <link rel="apple-touch-icon" href="/admin-icon-192.png" />
    <link rel="icon" href="/admin-icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Walryvo" />
    <style is:inline>
      :root {
        --bg: #0b0b0c; --panel: #141417; --line: #26262b;
        --ink: #f4f4f5; --dim: #a1a1aa; --faint: #6b6b74;
        --good: #34d399; --warn: #fbbf24; --live: #22c55e;
        --accent: #818cf8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 15px/1.5 ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); }
      .bar {
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        padding: 14px 16px; border-bottom: 1px solid var(--line);
        background: #0e0e10; position: sticky; top: 0; z-index: 5;
      }
      .bar h1 { font-size: 15px; margin: 0; font-weight: 600; letter-spacing: .2px; }
      .bar .sp { flex: 1; }
      .pill {
        display: inline-flex; align-items: center; gap: 7px;
        border: 1px solid var(--line); border-radius: 999px;
        padding: 5px 12px; font-size: 13px; color: var(--dim);
      }
      .dot {
        width: 8px; height: 8px; border-radius: 50%; background: var(--faint);
        box-shadow: 0 0 0 0 rgba(34,197,94,.6);
      }
      .dot.on { background: var(--live); animation: pulse 2s infinite; }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(34,197,94,.55); }
        70% { box-shadow: 0 0 0 9px rgba(34,197,94,0); }
        100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
      }
      main { padding: 16px; max-width: 1180px; margin: 0 auto; }
      .grid {
        display: grid; gap: 12px;
        grid-template-columns: repeat(auto-fit, minmax(158px, 1fr));
        margin-bottom: 20px;
      }
      .card {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: 12px; padding: 14px 16px;
      }
      .card .k {
        font-size: 11px; text-transform: uppercase; letter-spacing: .09em;
        color: var(--faint); margin-bottom: 8px;
      }
      .card .v {
        font-size: 30px; line-height: 1.1; font-weight: 650;
        font-variant-numeric: tabular-nums;
      }
      .card .s { font-size: 12.5px; color: var(--dim); margin-top: 6px; }
      .v.live { color: var(--live); }
      section { margin-bottom: 22px; }
      h2 {
        font-size: 12px; text-transform: uppercase; letter-spacing: .09em;
        color: var(--faint); margin: 0 0 10px; font-weight: 600;
      }
      .panel {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: 12px; overflow: hidden;
      }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th {
        text-align: left; white-space: nowrap; font-size: 11px; letter-spacing: .07em;
        text-transform: uppercase; color: var(--faint); font-weight: 600;
        padding: 10px 14px; border-bottom: 1px solid var(--line);
      }
      td { padding: 9px 14px; border-bottom: 1px solid #1c1c20; white-space: nowrap; }
      tr:last-child td { border-bottom: 0; }
      td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
      .muted { color: var(--dim); }
      .empty { padding: 26px 16px; text-align: center; color: var(--faint); }
      .two { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
      @media (max-width: 760px) { .two { grid-template-columns: 1fr; } }
      .chart { display: flex; align-items: flex-end; gap: 4px; height: 90px; padding: 14px; }
      .chart i {
        flex: 1; background: #2b2b33; border-radius: 3px 3px 0 0; min-height: 2px;
        display: block; position: relative;
      }
      .chart i.hi { background: var(--accent); }
      .chart i.today { background: var(--live); }
      .lbl { display: flex; gap: 4px; padding: 0 14px 12px; font-size: 10px; color: var(--faint); }
      .lbl span { flex: 1; text-align: center; overflow: hidden; }
      td.path {
        max-width: 1px; width: 99%;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      @media (max-width: 560px) {
        main { padding: 12px; }
        .card .v { font-size: 24px; }
        td, th { padding: 8px 10px; }
        .hide-sm { display: none; }
        .lbl span:nth-child(even) { visibility: hidden; }
      }
      .note {
        font-size: 12.5px; color: var(--faint); margin: 8px 2px 0; line-height: 1.5;
      }
      .btn {
        display: inline-flex; align-items: center; gap: 7px;
        border: 1px solid var(--line); background: #17171b; color: var(--ink);
        border-radius: 8px; padding: 7px 12px; font-size: 13px;
        cursor: pointer; width: auto; margin: 0; font-weight: 500;
      }
      .btn:hover { border-color: #3a3a42; }
      .btn.go { background: var(--ink); color: #000; border-color: var(--ink); }
      .mailwrap { display: grid; grid-template-columns: 320px 1fr; min-height: 260px; }
      @media (max-width: 860px) { .mailwrap { grid-template-columns: 1fr; } }
      .maillist { border-right: 1px solid var(--line); max-height: 460px; overflow-y: auto; }
      @media (max-width: 860px) {
        .maillist { border-right: 0; border-bottom: 1px solid var(--line); max-height: 240px; }
      }
      .mi {
        display: block; width: 100%; text-align: left; background: none;
        border: 0; border-bottom: 1px solid #1c1c20; border-radius: 0;
        padding: 11px 14px; cursor: pointer; color: var(--ink); margin: 0;
        font-size: 14px; font-weight: 400;
      }
      .mi:hover { background: #18181c; }
      .mi.sel { background: #1d1d23; box-shadow: inset 3px 0 0 var(--accent); }
      .mi .who { display: flex; justify-content: space-between; gap: 8px; }
      .mi .nm { font-weight: 600; font-size: 13.5px; }
      .mi.unread .nm::before {
        content: ''; display: inline-block; width: 7px; height: 7px;
        border-radius: 50%; background: var(--accent); margin-right: 7px;
        vertical-align: middle;
      }
      .mi .when { color: var(--faint); font-size: 11.5px; white-space: nowrap; }
      .mi .sub {
        font-size: 13px; color: var(--dim); margin-top: 3px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .mi .pv {
        font-size: 12.5px; color: var(--faint); margin-top: 2px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .mailbody { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
      .mailbody h3 { margin: 0; font-size: 16px; }
      .mailbody .meta { font-size: 12.5px; color: var(--faint); }
      .mailbody pre {
        margin: 0; white-space: pre-wrap; word-break: break-word;
        font: inherit; color: var(--dim); max-height: 230px; overflow-y: auto;
      }
      textarea {
        width: 100%; min-height: 110px; resize: vertical; padding: 11px 12px;
        border-radius: 9px; background: #0e0e10; border: 1px solid var(--line);
        color: var(--ink); font: inherit;
      }
      .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
      .ok { color: var(--good); font-size: 13px; }
      .err {
        background: #2a1416; border: 1px solid #562226; color: #fca5a5;
        border-radius: 10px; padding: 12px 14px; font-size: 14px; margin-bottom: 16px;
      }
      form.login { max-width: 330px; margin: 16vh auto; padding: 0 16px; }
      form.login h1 { font-size: 17px; margin: 0 0 4px; }
      form.login p { color: var(--dim); font-size: 13.5px; margin: 0 0 18px; }
      input[type=password] {
        width: 100%; padding: 11px 12px; border-radius: 9px; font-size: 15px;
        background: #0e0e10; border: 1px solid var(--line); color: var(--ink);
      }
      button {
        margin-top: 10px; width: 100%; padding: 11px; border-radius: 9px;
        border: 0; background: var(--ink); color: #000; font-size: 15px;
        font-weight: 600; cursor: pointer;
      }
    </style>
  </head>
  <body>
    {!key && (
      <form class="login">
        <h1>Back office is not switched on</h1>
        <p>
          This Worker has no <code>ADMIN_KEY</code>. From <code>web/site</code>,
          run <code>npx wrangler secret put ADMIN_KEY</code>, type a long
          password when prompted, then reload this page. There is deliberately
          no default — without a key this page would be public.
        </p>
      </form>
    )}

    {key && !ok && (
      <form class="login" method="POST">
        <h1>Walryvo back office</h1>
        <p>{bad ? 'That key was not right. Try again.' : 'Enter the admin key.'}</p>
        <input type="password" name="key" autocomplete="current-password"
               placeholder="Admin key" autofocus required />
        <button type="submit">Open</button>
      </form>
    )}

    {key && ok && (
      <>
        <div class="bar">
          <h1>Walryvo</h1>
          <span class="pill"><span class="dot" id="dot"></span><span id="livetxt">connecting…</span></span>
          <span class="sp"></span>
          <span class="pill muted" id="stamp">—</span>
        </div>
        <main>
          <div id="err"></div>
          <div class="grid" id="tiles"></div>

          <section>
            <h2>Visitors, last 14 days</h2>
            <div class="panel">
              <div class="chart" id="chart"></div>
              <div class="lbl" id="chartlbl"></div>
            </div>
          </section>

          <section>
            <h2>Happening now</h2>
            <div class="panel" id="livefeed"></div>
            <p class="note">
              Anyone who has loaded a page in the last five minutes. No cookie
              is set and no IP address is stored — a visitor is a salted hash
              that changes at midnight.
            </p>
          </section>

          <div class="two">
            <section>
              <h2>Where they came from, 7 days</h2>
              <div class="panel" id="sources"></div>
            </section>
            <section>
              <h2>Most viewed pages, 7 days</h2>
              <div class="panel" id="pages"></div>
            </section>
          </div>

          <section>
            <h2>Customer inbox</h2>
            <div class="panel" id="mail"></div>
            <p class="note" id="mailnote"></p>
          </section>

          <section>
            <h2>This phone</h2>
            <div class="panel" style="padding:14px 16px">
              <div class="row" id="pushrow"><span class="muted">checking…</span></div>
              <p class="note" id="pushnote" style="margin-top:10px"></p>
            </div>
          </section>

          <section>
            <h2>Orders</h2>
            <div class="panel" id="orders"></div>
          </section>

          <section>
            <h2>Search engines crawling the shop, 7 days</h2>
            <div class="panel" id="crawls"></div>
            <p class="note">
              Counted per day rather than per request, and batched, so treat
              these as a lower bound. Googlebot-Image fetching product
              photographs is the signal that the Merchant Center feed is being
              processed — it is what the 192 "image not processed" rejections
              were about.
            </p>
          </section>
        </main>

        <script is:inline>
          const $ = (id) => document.getElementById(id);
          const money = (n) =>
            '£' + Number(n || 0).toLocaleString('en-GB', {
              minimumFractionDigits: 2, maximumFractionDigits: 2 });
          const esc = (s) =>
            String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
              '&': '&amp;', '<': '&lt;', '>': '&gt;',
              '"': '&quot;', "'": '&#39;' }[c]));
          const ago = (s) =>
            s < 60 ? s + 's ago' : s < 3600 ? Math.floor(s / 60) + 'm ago'
                                            : Math.floor(s / 3600) + 'h ago';
          const rows = (head, body, empty) =>
            body.length
              ? '<table><thead><tr>' + head + '</tr></thead><tbody>' +
                body.join('') + '</tbody></table>'
              : '<div class="empty">' + empty + '</div>';

          function tile(k, v, s, cls) {
            return '<div class="card"><div class="k">' + k + '</div>' +
              '<div class="v ' + (cls || '') + '">' + v + '</div>' +
              '<div class="s">' + (s || '') + '</div></div>';
          }

          function draw(d) {
            $('err').innerHTML = '';
            const on = d.live > 0;
            $('dot').className = 'dot' + (on ? ' on' : '');
            $('livetxt').textContent =
              d.live + (d.live === 1 ? ' visitor right now' : ' visitors right now');
            $('stamp').textContent = new Date().toLocaleTimeString('en-GB');

            const conv = d.checkouts.d30
              ? ((d.orders.count.d30 / d.checkouts.d30) * 100).toFixed(1) + '%'
              : '—';
            $('tiles').innerHTML = [
              tile('Live', d.live, 'in the last 5 minutes', on ? 'live' : ''),
              tile('Visitors today', d.visitors.today, d.views.today + ' page views'),
              tile('Visitors, 7 days', d.visitors.d7, d.views.d7 + ' page views'),
              tile('Orders today', d.orders.count.today, money(d.orders.revenue.today)),
              tile('Orders, 30 days', d.orders.count.d30, money(d.orders.revenue.d30)),
              tile('All-time revenue', money(d.orders.revenue.all),
                   d.orders.count.all + ' orders'),
              tile('Google Shopping, 7d', d.google.shopping7,
                   d.google.shoppingAll + ' all time'),
              tile('Checkouts, 30d', d.checkouts.d30, 'conversion ' + conv),
            ].join('');

            const max = Math.max(1, ...d.series.map((p) => p.views));
            const last = d.series.length - 1;
            $('chart').innerHTML = d.series.map((p, i) =>
              '<i class="' + (i === last && p.views ? 'today'
                              : p.views ? 'hi' : '') + '" style="height:' +
              Math.max(2, Math.round((p.views / max) * 100)) +
              '%" title="' + p.day + ': ' + p.views + ' views, ' +
              p.visitors + ' visitors"></i>').join('');
            $('chartlbl').innerHTML =
              d.series.map((p) => '<span>' + p.day.slice(8) + '</span>').join('');

            $('livefeed').innerHTML = rows(
              '<th>Page</th><th>Source</th><th class="hide-sm">From</th><th class="n">When</th>',
              d.liveList.map((h) =>
                '<tr><td class="mono path" title="' + esc(h.path) + '">' +
                esc(h.path) + '</td><td>' +
                esc(h.src) + '</td><td class="muted hide-sm">' +
                esc(h.country || '—') + '</td><td class="n muted">' +
                ago(h.ago) + '</td></tr>'),
              'Nobody on the site in the last five minutes.');

            $('sources').innerHTML = rows(
              '<th>Source</th><th class="n">Visitors</th><th class="n">Views</th>',
              d.sources.map((s) =>
                '<tr><td>' + esc(s.src) + '</td><td class="n">' + s.visitors +
                '</td><td class="n">' + s.n + '</td></tr>'),
              'No visits recorded in the last 7 days.');

            $('pages').innerHTML = rows(
              '<th>Page</th><th class="n">Views</th>',
              d.pages.map((p) =>
                '<tr><td class="mono path" title="' + esc(p.path) + '">' +
                esc(p.path) + '</td><td class="n">' + p.n + '</td></tr>'),
              'No page views recorded in the last 7 days.');

            $('orders').innerHTML = rows(
              '<th>Order</th><th>When</th><th>Email</th><th>Status</th><th class="n">Total</th>',
              d.orders.recent.map((o) =>
                '<tr><td class="mono">' + esc(o.id.slice(-12)) + '</td><td class="muted">' +
                esc(o.created.replace('T', ' ').slice(0, 16)) + '</td><td class="muted">' +
                esc(o.email || '—') + '</td><td>' + esc(o.status) +
                '</td><td class="n">' + money(o.total) + '</td></tr>'),
              'No orders yet.');

            $('crawls').innerHTML = rows(
              '<th>Crawler</th><th class="n">Pages</th><th class="n">Images</th>' +
              '<th class="n">Feeds</th><th class="n hide-sm">Other</th>',
              d.crawls.map((c) =>
                '<tr><td>' + esc(c.bot) + '</td><td class="n">' + c.pages +
                '</td><td class="n">' + c.images + '</td><td class="n">' +
                c.feeds + '</td><td class="n muted hide-sm">' + c.other +
                '</td></tr>'),
              'No crawler has visited since this started recording.');
          }

          // ---------------------------------------------------------------
          // The customer inbox.
          // ---------------------------------------------------------------
          let mail = [];
          let selected = null;
          let openMsg = null;

          async function loadMail() {
            try {
              const r = await fetch('/api/mail', { cache: 'no-store' });
              const d = await r.json();
              if (d.configured === false) {
                $('mail').innerHTML =
                  '<div class="empty">The inbox is not connected yet.</div>';
                $('mailnote').textContent =
                  'Connecting it takes one app registration in Microsoft ' +
                  'Entra and three secrets — web/INBOX.md has the ' +
                  'click-by-click. Until then, customer email arrives in ' +
                  'Outlook as usual; nothing is lost.';
                return;
              }
              if (d.error) throw new Error(d.error);
              mail = d.messages || [];
              $('mailnote').textContent =
                'Live from sales@walryvo.com. Reading a message here marks ' +
                'it read in Outlook too, and a reply goes out in the same ' +
                'thread from the same address.';
              drawMail();
            } catch (e) {
              $('mail').innerHTML =
                '<div class="empty">Inbox unavailable: ' + esc(e.message) + '</div>';
            }
          }

          function drawMail() {
            if (!mail.length) {
              $('mail').innerHTML = '<div class="empty">No messages.</div>';
              return;
            }
            const list = mail.map((m, i) =>
              '<button class="mi' + (m.read ? '' : ' unread') +
              (i === selected ? ' sel' : '') + '" data-i="' + i + '">' +
              '<span class="who"><span class="nm">' + esc(m.fromName) +
              '</span><span class="when">' +
              new Date(m.received).toLocaleDateString('en-GB', {
                day: 'numeric', month: 'short' }) + '</span></span>' +
              '<div class="sub">' + esc(m.subject) + '</div>' +
              '<div class="pv">' + esc(m.preview.slice(0, 90)) + '</div>' +
              '</button>').join('');

            let body = '<div class="mailbody"><div class="empty">' +
              'Pick a message.</div></div>';
            if (openMsg) {
              body =
                '<div class="mailbody">' +
                '<h3>' + esc(openMsg.subject) + '</h3>' +
                '<div class="meta">' + esc(openMsg.fromName) + ' &lt;' +
                esc(openMsg.from) + '&gt; · ' +
                esc(new Date(openMsg.received).toLocaleString('en-GB')) +
                (openMsg.hasAttachments
                  ? ' · has attachments (open in Outlook to download)' : '') +
                '</div>' +
                '<pre>' + esc(openMsg.text) + '</pre>' +
                '<textarea id="reply" placeholder="Write a reply…"></textarea>' +
                '<div class="row">' +
                '<button class="btn go" id="send">Send reply</button>' +
                '<span id="sendmsg" class="muted"></span></div></div>';
            }
            $('mail').innerHTML =
              '<div class="mailwrap"><div class="maillist">' + list +
              '</div>' + body + '</div>';

            $('mail').querySelectorAll('.mi').forEach((b) =>
              b.addEventListener('click', () => openMail(Number(b.dataset.i))));
            const send = $('send');
            if (send) send.addEventListener('click', sendReply);
          }

          async function openMail(i) {
            selected = i;
            openMsg = null;
            drawMail();
            try {
              const r = await fetch('/api/mail?id=' + encodeURIComponent(mail[i].id),
                                    { cache: 'no-store' });
              const d = await r.json();
              if (d.error) throw new Error(d.error);
              openMsg = d.message;
              mail[i].read = true;
              drawMail();
            } catch (e) {
              $('mail').innerHTML =
                '<div class="empty">Could not open it: ' + esc(e.message) + '</div>';
            }
          }

          async function sendReply() {
            const ta = $('reply');
            const btn = $('send');
            const msg = $('sendmsg');
            if (!ta || !ta.value.trim() || !openMsg) return;
            btn.disabled = true;
            msg.textContent = 'Sending…';
            msg.className = 'muted';
            try {
              const r = await fetch('/api/mail', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ id: openMsg.id, text: ta.value }),
              });
              const d = await r.json();
              if (!r.ok || d.error) throw new Error(d.error || ('HTTP ' + r.status));
              ta.value = '';
              msg.textContent = 'Sent, in the same thread.';
              msg.className = 'ok';
            } catch (e) {
              msg.textContent = e.message;
              msg.className = 'err';
              msg.style.cssText = 'color:#fca5a5;font-size:13px';
            }
            btn.disabled = false;
          }

          // ---------------------------------------------------------------
          // Notifications on this device.
          // ---------------------------------------------------------------
          const standalone =
            window.matchMedia('(display-mode: standalone)').matches ||
            window.navigator.standalone === true;

          function urlB64ToU8(s) {
            const pad = (s + '='.repeat((4 - (s.length % 4)) % 4))
              .replace(/-/g, '+').replace(/_/g, '/');
            const raw = atob(pad);
            const out = new Uint8Array(raw.length);
            for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
            return out;
          }

          async function pushState() {
            const row = $('pushrow');
            const note = $('pushnote');
            let cfg;
            try {
              cfg = await (await fetch('/api/push', { cache: 'no-store' })).json();
            } catch {
              row.innerHTML = '<span class="muted">Could not check.</span>';
              return;
            }
            if (!cfg.configured) {
              row.innerHTML = '<span class="muted">Notifications are switched off.</span>';
              note.textContent =
                'Run `node web/tools/vapid-keys.mjs` and set the two secrets ' +
                'it prints, then deploy. No app store, no account, nothing ' +
                'to pay for.';
              return;
            }
            const supported = 'serviceWorker' in navigator && 'PushManager' in window;
            // iOS is the reason this check exists: Safari has Push, but
            // ONLY once the site has been added to the Home Screen. Asking
            // in a browser tab silently fails and looks like a bug.
            const iOS = /iP(hone|ad|od)/.test(navigator.userAgent);
            if (!supported || (iOS && !standalone)) {
              row.innerHTML = '<span class="muted">Add to Home Screen first.</span>';
              note.textContent = iOS
                ? 'On iPhone: tap Share, then "Add to Home Screen", then open ' +
                  'Walryvo from the new icon and come back here. iOS only ' +
                  'allows notifications from an installed app.'
                : 'This browser does not support web notifications.';
              return;
            }

            const reg = await navigator.serviceWorker.register('/admin-sw.js')
              .catch(() => null);
            if (!reg) {
              row.innerHTML = '<span class="muted">Service worker blocked.</span>';
              return;
            }
            const sub = await reg.pushManager.getSubscription();
            const count = cfg.count || 0;

            if (sub && Notification.permission === 'granted') {
              row.innerHTML =
                '<span class="ok">Notifications are on for this device.</span>' +
                '<button class="btn" id="ptest">Send a test</button>' +
                '<button class="btn" id="poff">Turn off</button>';
              note.textContent =
                count + ' device' + (count === 1 ? '' : 's') +
                ' will be told when an order comes in.';
              $('ptest').onclick = async () => {
                const d = await (await fetch('/api/push', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ test: true }),
                })).json();
                note.textContent = d.note || d.error || 'Sent.';
              };
              $('poff').onclick = async () => {
                await fetch('/api/push', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ unsubscribe: sub.endpoint }),
                });
                await sub.unsubscribe().catch(() => {});
                pushState();
              };
              return;
            }

            row.innerHTML =
              '<button class="btn go" id="pon">Turn on notifications</button>';
            note.textContent =
              'You will be told when an order comes in. Nothing about the ' +
              'order passes through Apple or Google — they are only told to ' +
              'wake this app up, and it then asks the shop what happened.';
            $('pon').onclick = async () => {
              // Must be inside the click: iOS refuses a permission prompt
              // that is not the direct result of a tap.
              const perm = await Notification.requestPermission();
              if (perm !== 'granted') {
                note.textContent =
                  'Permission was refused. iOS will not ask again unless ' +
                  'you turn it back on in Settings → Notifications → Walryvo.';
                return;
              }
              try {
                const s = await reg.pushManager.subscribe({
                  userVisibleOnly: true,
                  applicationServerKey: urlB64ToU8(cfg.publicKey),
                });
                const r = await fetch('/api/push', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ subscription: s.toJSON() }),
                });
                const d = await r.json();
                if (!r.ok || d.error) throw new Error(d.error || ('HTTP ' + r.status));
                pushState();
              } catch (e) {
                note.textContent = 'Could not subscribe: ' + e.message;
              }
            };
          }

          let failures = 0;
          async function tick() {
            try {
              const r = await fetch('/api/admin', { headers: { accept: 'application/json' } });
              const d = await r.json();
              if (!r.ok) throw new Error(d.error || ('HTTP ' + r.status));
              failures = 0;
              draw(d);
            } catch (e) {
              failures++;
              $('err').innerHTML =
                '<div class="err">' + esc(e.message) + '</div>';
              $('dot').className = 'dot';
              $('livetxt').textContent = 'not updating';
            }
            // Back off if it keeps failing, so a broken deploy does not get
            // hammered by a tab somebody left open.
            setTimeout(tick, failures > 3 ? 60000 : 10000);
          }
          tick();
          loadMail();
          pushState();
          // The inbox is a round trip to Microsoft; a minute is plenty, and
          // polling it as hard as the numbers would be rude to both of us.
          setInterval(loadMail, 60000);
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden) { tick(); loadMail(); }
          });
        </script>
      </>
    )}
  </body>
</html>
