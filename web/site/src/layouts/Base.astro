---
// The shell every page wears.
//
// The footer carries the full legal identity on EVERY page. That is not
// decoration: a UK limited company must publish its registered name, number
// and office address (Companies Act 2006, E-Commerce Regulations 2002), and
// the same block is the first thing a Merchant Center reviewer looks for
// when deciding whether this is a real business. Google's misrepresentation
// policy leads with "present a false identity, business name, or contact
// information" - so the cure is to present a true one, everywhere, without
// being asked.
import { PROMO } from '../lib/promo';
import '../styles/global.css';
import { B, TAX, deliveryLine, returnsLine, money, orderBy } from '../lib/shop';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: unknown;
  /** [{name, url}] - rendered as BreadcrumbList for Search. */
  crumbs?: { name: string; url: string }[];
  noindex?: boolean;
}
const { title, description, canonical, jsonLd, crumbs, noindex } = Astro.props;
const env = (Astro.locals as any)?.runtime?.env;
const base = (env?.SITE_URL || `https://${B.domain}`).replace(/\/$/, '');
const canon = canonical ?? base + Astro.url.pathname;
const year = new Date().getFullYear();

const addr = B.registered_address ?? [];
const trading = B.trading_address_same ? addr : (B.trading_address ?? addr);
const d = B.fulfilment.delivery[0];

// ORGANIZATION MARKUP ON EVERY PAGE, not just /contact.
//
// Google's editorial requirements say contact details must be clear,
// accessible, and must match the Merchant Center account. The footer says
// it to humans; this says the same thing, from the same config, to the
// crawler - so there is one set of business facts on the site and it is
// machine-readable wherever a reviewer or a bot happens to land.
const org = {
  '@type': 'Organization',
  '@id': `${base}/#organization`,
  name: B.legal_name,
  alternateName: B.brand,
  url: base,
  email: B.email,
  telephone: B.phone,
  vatID: B.vat_number,
  identifier: B.company_number,
  address: {
    '@type': 'PostalAddress',
    streetAddress: addr.slice(0, -2).join(', '),
    addressLocality: addr[addr.length - 2] ?? '',
    postalCode: addr[addr.length - 1] ?? '',
    addressCountry: 'GB',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: B.email,
    telephone: B.phone,
    areaServed: 'GB',
    availableLanguage: 'English',
  },
};

const graph: any[] = [
  org,
  {
    '@type': 'WebSite',
    '@id': `${base}/#website`,
    url: base,
    name: B.brand,
    publisher: { '@id': `${base}/#organization` },
    inLanguage: 'en-GB',
  },
];
if (crumbs?.length)
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: c.url.startsWith('http') ? c.url : base + c.url,
    })),
  });
if (jsonLd) graph.push(jsonLd);
const ld = { '@context': 'https://schema.org', '@graph': graph };
const gift = orderBy();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={B.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta name="theme-color" content="#edeae3" />
    {/* The same mark as the header logo, reduced until it still reads at
        16px: the frame, the moon, the horizon. Inline so there is no
        favicon request and no 404 in the server log. */}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='3' fill='%23edeae3'/%3E%3Crect x='4.25' y='2.75' width='15.5' height='18.5' rx='.75' fill='none' stroke='%231b1a18' stroke-width='1.5'/%3E%3Ccircle cx='14.4' cy='9.4' r='2.15' fill='%236b5b3e'/%3E%3Cpath d='M7 15.6c1.9 0 2.5-2.1 4.3-2.1s2.2 1.5 3.4 1.5c1 0 1.4-.6 2.3-.6' fill='none' stroke='%231b1a18' stroke-width='1.3' stroke-linecap='round'/%3E%3C/svg%3E"
    />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    {/* The offer goes above everything, on every page. A promotion a
        shopper only discovers in the basket does not change what they put
        in it. */}
    {/* A real deadline, computed backwards from when it has to arrive, and
        it removes itself once the date has passed. The only honest urgency
        a print shop has - and a strong one, because prints are bought as
        gifts and the date is somebody else's, not ours. */}
    {gift && (
      <div class="promo-bar deadline">
        <a href="/delivery">
          <strong>Order by {gift.label}</strong>
          <span>for {gift.occasion} delivery</span>
        </a>
      </div>
    )}
    {PROMO.active && (
      <div class="promo-bar">
        <a href="/delivery#offer">
          <strong>{PROMO.title}</strong>
          <span>Add any three prints — the cheapest one is free.</span>
        </a>
      </div>
    )}
    <div class="head-note">{deliveryLine()} {returnsLine()}</div>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="logo" href="/" aria-label={`${B.brand} home`}><Logo size={30} /></a>
        <nav class="nav" aria-label="Main">
          {TAX.sections.map((s) => (
            <a href={`/c/${s.slug}`}>{s.title}</a>
          ))}
          <a href="/style">Styles</a>
          <a href="/rooms">Rooms</a>
        </nav>
        <a class="nav" href="/cart" style="text-decoration:none">
          <span>Basket</span>
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-cols">
          <div>
            <a href="/" class="foot-logo" aria-label={`${B.brand} home`}>
              <Logo size={26} />
            </a>
            <h4>Shop</h4>
            <ul>
              {TAX.sections.map((s) => (
                <li><a href={`/c/${s.slug}`}>{s.title}</a></li>
              ))}
              <li><a href="/style">Shop by style</a></li>
              <li><a href="/rooms">Shop by room</a></li>
            </ul>
          </div>
          <div>
            <h4>Help</h4>
            <ul>
              <li><a href="/delivery">Delivery</a></li>
              <li><a href="/returns">Returns &amp; refunds</a></li>
              <li><a href="/contact">Contact us</a></li>
              <li><a href="/faq">Frequently asked</a></li>
            </ul>
          </div>
          <div>
            <h4>About</h4>
            <ul>
              <li><a href="/about">About {B.brand}</a></li>
              <li><a href="/how-its-made">How it is made</a></li>
              <li><a href="/terms">Terms &amp; conditions</a></li>
              <li><a href="/privacy">Privacy &amp; cookies</a></li>
            </ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              <li><a href={`mailto:${B.email}`}>{B.email}</a></li>
              <li><a href={`tel:${(B.phone || '').replace(/\s/g, '')}`}>{B.phone}</a></li>
              <li>{B.support_hours}</li>
            </ul>
            <div class="pay">
              <span>Card, Apple Pay &amp; Google Pay via Stripe</span>
            </div>
          </div>
        </div>

        {/* THE DELIVERY AND RETURNS TERMS, STATED IN THE FOOTER ITSELF.
            Google asks for the return policy to be consistent "in the
            footer, returns page and web banner" - so it is written out
            here in full rather than only linked, and every number comes
            from the same config the returns page and the feed read. */}
        <div class="legal">
          <strong>Delivery &amp; returns.</strong>{' '}
          {d.price === 0 ? 'Free UK delivery' : `UK delivery ${money(d.price)}`}.
          Made to order and dispatched within
          {' '}{B.fulfilment.dispatch_working_days} working days, then
          {' '}{d.min_days}&ndash;{d.max_days} working days in the post.
          {' '}{B.returns.window_days} days to return anything from the day
          it arrives, for any reason;
          {B.returns.who_pays_return_postage === 'customer'
            ? ' return postage is paid by you unless the item is faulty'
            : ' we pay the return postage'}{B.returns.restocking_fee === 0
            ? ', and there is no restocking fee.'
            : '.'}
          Refunds go back to your original payment method within 5 working
          days of the parcel reaching us. Full detail on our
          {' '}<a href="/returns">returns page</a> and
          {' '}<a href="/delivery">delivery page</a>.
        </div>

        <div class="legal">
          <strong>{B.legal_name}</strong> &middot; a company registered in
          England and Wales, company number {B.company_number} &middot; VAT
          registration {B.vat_number}.<br />
          Registered office: {addr.join(', ')}.<br />
          {!B.trading_address_same && <>Goods are dispatched from: {trading.join(', ')}.<br /></>}
          Contact: <a href={`mailto:${B.email}`}>{B.email}</a> &middot;
          {' '}<a href={`tel:${(B.phone || '').replace(/\s/g, '')}`}>{B.phone}</a>
          {' '}&middot; {B.support_hours}.<br />
          All prices include VAT at the UK standard rate. Orders are printed
          and framed in {B.fulfilment.made_in}. We currently deliver to the
          United Kingdom only.<br />
          If something goes wrong, email us first — we aim to resolve
          complaints within 5 working days.<br />
          &copy; {year} {B.legal_name}. Artwork is digitally created and
          printed to order; it is not a painting, an original or a signed
          work.
        </div>
      </div>
    </footer>
  </body>
</html>
